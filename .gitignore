# Secrets — never commit tokens, .env files, or private keys
secrets/
.env
.env.*
*.pem
*.key

# Settings files that can carry tokens
settings.json
settings.yml
settings.yaml
settings.toml
settings.local.*

# Local Python
.venv/
__pycache__/
*.py[cod]

# Runtime data and logs. Desk JSON is published under web/d/<secret>/.
*.db
logs/
/d/

# OS
.DS_Store
